{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Spark",
  "identifier": "com.hao.spark",
  "build": {},
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "spark"
        ],
        "name": "Spark design",
        "description": "Spark design file",
        "role": "Editor",
        "mimeType": "application/x-spark"
      }
    ],
    "category": "DeveloperTool"
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "spark"
        ]
      }
    },
    "updater": {
      "endpoints": [
        "https://github.com/FOwen123/Spark/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVGRkEzMkE3MjMzRDQ3NDAKUldSQVJ6MGpwekw2WDR6NHNmMW41a3lDM2JGQ2YvVjRhWVZtdFVkZnJ3dkU1Y0Y3bCtwRGRHbm0K"
    }
  }
}
