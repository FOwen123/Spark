{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "drag",
  "description": "Lets the UI page served by Spark's local server move and zoom the window from the app bar",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "http://127.0.0.1:*"
    ]
  },
  "permissions": [
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize"
  ]
}
